[user]
	email = iam@juneyoung.io
	name = stevejkang
	signingkey = FE3B6BCB75676E0B5514104D85D2EA75C4BC40E8
[core]
	editor = vim
	ignorecase = false
	filemode = true
	excludesfile = ~/.gitignore-global
[init]
	defaultBranch = main
[commit]
	gpgsign = true
[tag]
	gpgsign = true
[push]
	autoSetupRemote = true
	followTags = true
[pull]
	ff = only
[log]
	date = iso
[alias]
	re = rebase --committer-date-is-author-date
[gpg]
	program = gpg
[includeIf "gitdir:~/src/github.com/wanteddev/"]
	path = ~/.gitconfig-wanteddev
[credential]
	helper = osxkeychain
[branch]
	sort = -committerdate
[fetch]
	prune = true
[rerere]
	enabled = true
