#!/bin/bash
# key file hash (triggers re-run on change):
# {{ include (joinPath .chezmoi.sourceDir "private_dot_ssh/encrypted_private_id_ed25519.age") | sha256sum }}
set -euo pipefail

echo "Adding SSH key to Apple Keychain..."

SSH_KEY="$HOME/.ssh/id_ed25519"

if [ ! -f "$SSH_KEY" ]; then
  echo "SSH key not found: $SSH_KEY"
  exit 1
fi

if [ -e /dev/tty ]; then
  exec < /dev/tty
  ssh-add --apple-use-keychain "$SSH_KEY" && echo "SSH key added to Keychain"
else
  echo "Skipping ssh-add: no TTY available. Run manually: ssh-add --apple-use-keychain $SSH_KEY"
  exit 0
fi
