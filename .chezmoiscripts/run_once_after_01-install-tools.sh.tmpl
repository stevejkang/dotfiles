{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash
set -euo pipefail

eval "$(/opt/homebrew/bin/brew shellenv 2>/dev/null || /usr/local/bin/brew shellenv 2>/dev/null)"

# opencode (version-pinned)
if ! command -v opencode &> /dev/null; then
  echo "Installing opencode..."
  curl -fsSL https://opencode.ai/install | bash -s -- -v 1.17.13 --no-modify-path
fi

# Node.js (via fnm)
if ! command -v node &> /dev/null; then
  echo "Installing Node.js via fnm..."
  eval "$(fnm env --shell bash)"
  fnm install --lts
  fnm default lts-latest
  fnm use lts-latest
  eval "$(fnm env --shell bash)"
fi

# yarn (via corepack)
if ! command -v yarn &> /dev/null; then
  echo "Installing yarn via corepack..."
  eval "$(fnm env --shell bash)"
  fnm use lts-latest
  corepack enable yarn
  corepack prepare yarn@stable --activate
fi

# bun
if ! command -v bun &> /dev/null; then
  echo "Installing bun..."
  curl -fsSL https://bun.sh/install | bash
fi

# go
if ! command -v go &> /dev/null; then
  echo "Installing go..."
  GO_VERSION=$(curl -fsSL https://go.dev/VERSION?m=text | head -1)
  curl -fsSL "https://go.dev/dl/${GO_VERSION}.darwin-arm64.tar.gz" -o /tmp/go.tar.gz
  sudo rm -rf /usr/local/go
  sudo tar -C /usr/local -xzf /tmp/go.tar.gz
  rm -f /tmp/go.tar.gz
fi

# pam-watchid (Apple Watch sudo authentication)
if [[ ! -f /usr/local/lib/pam/pam_watchid.so.2 ]]; then
  echo "Installing pam-watchid..."
  TEMP_DIR=$(mktemp -d)
  git clone --depth 1 https://github.com/mostpinkest/pam-watchid.git "$TEMP_DIR"
  (cd "$TEMP_DIR" && sudo make install)
  sudo rm -rf "$TEMP_DIR"
fi

echo "Non-brew tools installed"
{{ end -}}
