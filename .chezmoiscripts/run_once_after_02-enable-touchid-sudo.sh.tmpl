{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash
set -euo pipefail

PAM_SUDO="/etc/pam.d/sudo"
PAM_SUDO_LOCAL="/etc/pam.d/sudo_local"
PAM_TID_LINE="auth       sufficient     pam_tid.so"
BREW_PREFIX="$(brew --prefix 2>/dev/null || echo /opt/homebrew)"
PAM_REATTACH_SO="${BREW_PREFIX}/lib/pam/pam_reattach.so"
PAM_REATTACH_LINE="auth       optional       ${PAM_REATTACH_SO}"

supports_touchid() {
  if command -v bioutil &>/dev/null; then
    bioutil -r 2>/dev/null | grep -q "Touch ID" && return 0
  fi
  [[ "$(uname -m)" == "arm64" ]] && return 0
  return 1
}

is_touchid_configured() {
  if [[ -f "$PAM_SUDO_LOCAL" ]]; then
    grep -q "pam_tid.so" "$PAM_SUDO_LOCAL" 2>/dev/null && return 0
  fi
  [[ -f "$PAM_SUDO" ]] && grep -q "pam_tid.so" "$PAM_SUDO" 2>/dev/null
}

is_reattach_configured() {
  if [[ -f "$PAM_SUDO_LOCAL" ]]; then
    grep -q "pam_reattach.so" "$PAM_SUDO_LOCAL" 2>/dev/null && return 0
  fi
  [[ -f "$PAM_SUDO" ]] && grep -q "pam_reattach.so" "$PAM_SUDO" 2>/dev/null
}

if ! supports_touchid; then
  echo "Touch ID not supported on this Mac, skipping."
  exit 0
fi

if is_touchid_configured; then
  echo "Touch ID for sudo is already enabled."
  exit 0
fi

echo "Enabling Touch ID for sudo..."

# Sonoma+ uses sudo_local (sudo includes it via "auth include sudo_local")
if grep -q "sudo_local" "$PAM_SUDO" 2>/dev/null; then
  if [[ ! -f "$PAM_SUDO_LOCAL" ]]; then
    printf "# sudo_local: local config for sudo\n%s\n" "$PAM_TID_LINE" | sudo tee "$PAM_SUDO_LOCAL" >/dev/null
  else
    echo "$PAM_TID_LINE" | sudo tee -a "$PAM_SUDO_LOCAL" >/dev/null
  fi
  sudo chmod 444 "$PAM_SUDO_LOCAL"
  sudo chown root:wheel "$PAM_SUDO_LOCAL"
  echo "Touch ID enabled via sudo_local."
else
  # Pre-Sonoma: insert pam_tid.so as the first auth line in /etc/pam.d/sudo
  TEMP=$(mktemp)
  awk -v line="$PAM_TID_LINE" '
    !inserted && /^auth/ { print line; inserted=1 }
    { print }
  ' "$PAM_SUDO" > "$TEMP"
  sudo install -m 444 -o root -g wheel "$TEMP" "$PAM_SUDO"
  rm -f "$TEMP"
  echo "Touch ID enabled via /etc/pam.d/sudo."
fi

# pam_reattach: allow Touch ID to work inside tmux sessions
# Must appear before pam_tid.so; marked "optional" so missing .so is harmless
if [[ -f "$PAM_REATTACH_SO" ]] && ! is_reattach_configured; then
  echo "Enabling pam_reattach for tmux Touch ID support..."
  TARGET="${PAM_SUDO_LOCAL}"
  if [[ ! -f "$TARGET" ]]; then
    TARGET="${PAM_SUDO}"
  fi
  TEMP=$(mktemp)
  awk -v reattach="$PAM_REATTACH_LINE" '
    !inserted && /pam_tid\.so/ { print reattach; inserted=1 }
    { print }
  ' "$TARGET" > "$TEMP"
  sudo install -m 444 -o root -g wheel "$TEMP" "$TARGET"
  rm -f "$TEMP"
  echo "pam_reattach enabled."
elif [[ ! -f "$PAM_REATTACH_SO" ]]; then
  echo "pam_reattach not installed, skipping tmux support. Run: brew install pam-reattach"
elif is_reattach_configured; then
  echo "pam_reattach is already configured."
fi
{{ end -}}
