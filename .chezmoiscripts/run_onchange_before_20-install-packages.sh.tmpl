{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# packages hash: {{ include (joinPath .chezmoi.sourceDir ".chezmoidata/packages.yaml") | sha256sum }}
set -euo pipefail

export HOMEBREW_NO_AUTO_UPDATE=1

echo "Installing Homebrew packages..."

eval "$(/opt/homebrew/bin/brew shellenv 2>/dev/null || /usr/local/bin/brew shellenv 2>/dev/null)"

# Trust third-party taps before bundle install
{{ range .packages.taps -}}
brew trust --tap {{ . | quote }} 2>/dev/null || true
{{ end -}}

# Resolve tap/core shadow conflicts before bundle install
# When a formula is specified as tap/repo/name but the core version is
# installed, brew bundle skips it (thinking it's already present) and
# cleanup then removes it (since the core name doesn't match the tap name).
{{ range .packages.brews -}}
{{ if contains "/" . -}}
{{ $bare := . | base -}}
{{ $parts := splitList "/" . -}}
{{ $tap := printf "%s/%s" (index $parts 0) (index $parts 1) -}}
if brew list --formula {{ $bare | quote }} &>/dev/null && \
   ! grep -q '"tap": *"{{ $tap }}"' "$(brew --cellar {{ $bare | quote }})"/*/INSTALL_RECEIPT.json 2>/dev/null; then
  echo "Replacing {{ $bare }} with {{ . }}..."
  brew uninstall --formula {{ $bare | quote }} 2>/dev/null || true
fi
{{ end -}}
{{ end -}}
{{ range .packages.casks -}}
{{ if contains "/" . -}}
{{ $bare := . | base -}}
{{ $parts := splitList "/" . -}}
{{ $tap := printf "%s/%s" (index $parts 0) (index $parts 1) -}}
if brew list --cask {{ $bare | quote }} &>/dev/null && \
   ! grep -q '"tap": *"{{ $tap }}"' "$(brew --caskroom)/{{ $bare }}/.metadata/INSTALL_RECEIPT.json" 2>/dev/null; then
  echo "Replacing {{ $bare }} with {{ . }}..."
  brew uninstall --cask {{ $bare | quote }} 2>/dev/null || true
fi
{{ end -}}
{{ end -}}

BREWFILE=$(cat <<EOF
{{ range .packages.taps -}}
tap {{ . | quote }}
{{ end -}}
{{ range .packages.brews -}}
brew {{ . | quote }}
{{ end -}}
{{ range .packages.casks -}}
cask {{ . | quote }}
{{ end -}}
EOF
)

if ! echo "$BREWFILE" | brew bundle --file=/dev/stdin; then
  echo "Warning: brew bundle finished with errors (some packages may have failed to install)"
fi

echo "Homebrew packages installed"

# Declarative cleanup: remove packages not in packages.yaml
unlisted=$(echo "$BREWFILE" | brew bundle cleanup --file=/dev/stdin 2>/dev/null || true)

# Always clean up stale cache/old versions
brew cleanup 2>/dev/null || true

# Prompt only for actual formula/cask/tap uninstalls
if echo "$unlisted" | grep -q "^Would uninstall\|^Would untap"; then
  echo ""
  echo "The following packages are installed but not in packages.yaml:"
  echo "$unlisted"
  echo ""
  printf "Remove them? [y/N] "
  read -r answer </dev/tty
  if [ "$answer" = "y" ] || [ "$answer" = "Y" ]; then
    echo "$BREWFILE" | brew bundle cleanup --force --file=/dev/stdin 2>/dev/null || true
    echo "Cleanup done"
  else
    echo "Skipped cleanup"
  fi
fi
{{ end -}}
